---
import { noteHref, tagHref } from '../lib/notes.mjs';

interface Props { notes: any[]; searchable?: boolean; }
const { notes, searchable = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(date));
---

<ul class="note-list">
  {notes.map((note) => (
    <li class="note-item" data-note-row={searchable ? true : undefined} data-search={searchable ? `${note.data.title} ${note.data.description ?? ''} ${(note.data.tags ?? []).join(' ')} ${note.id}`.toLocaleLowerCase('zh-CN') : undefined}>
      <div class="note-line">
        <a class="note-title" href={noteHref(base, note.id)}>{note.data.title}</a>
        <time datetime={new Date(note.data.date).toISOString().slice(0, 10)}>{formatDate(note.data.date)}</time>
      </div>
      {note.data.description && <p class="note-description">{note.data.description}</p>}
      {(note.data.tags ?? []).length > 0 && (
        <div class="note-tags" aria-label="标签">
          {note.data.tags.map((tag: string) => <a href={tagHref(base, tag)}>#{tag}</a>)}
        </div>
      )}
    </li>
  ))}
</ul>
