---
import { collectTags, folderHref, groupByFolder, tagHref } from '../lib/notes.mjs';

interface Props {
  notes: any[];
  activeFolder?: string;
  activeTag?: string;
}

const { notes, activeFolder, activeTag } = Astro.props;
const base = import.meta.env.BASE_URL;
const folders = groupByFolder(notes);
const tags = collectTags(notes);
---

<aside class="sidebar" aria-label="笔记导航">
  <div class="sidebar-block" id="folders">
    <h2>目录</h2>
    <ul class="sidebar-links">
      {folders.map(([folder, entries]) => (
        <li>
          <a href={folderHref(base, folder)} aria-current={activeFolder === folder ? 'page' : undefined}>
            <span>{folder}</span><span class="count">{entries.length}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  {tags.length > 0 && (
    <div class="sidebar-block" id="tags">
      <h2>标签</h2>
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a class="tag-link" href={tagHref(base, tag)} aria-current={activeTag === tag ? 'page' : undefined}>
            <span># {tag}</span><span class="count">{count}</span>
          </a>
        ))}
      </div>
    </div>
  )}
</aside>
