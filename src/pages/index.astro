---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteList from '../components/NoteList.astro';
import { sortNotes } from '../lib/notes.mjs';

const notes = sortNotes(await getCollection('notes', ({ data }) => !data.draft));
---

<BaseLayout>
  <main class="site-main" id="main">
    <div class="page-intro home-intro">
      <h1>笔记</h1>
      <p>个人笔记，按文件夹和标签整理。</p>
    </div>
    {notes.length > 0 ? (
      <NoteList notes={notes} />
    ) : (
      <p class="empty-state">还没有公开的笔记。</p>
    )}
  </main>
</BaseLayout>
