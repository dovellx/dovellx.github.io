---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteList from '../../components/NoteList.astro';
import { folderOf, groupByFolder, sortNotes } from '../../lib/notes.mjs';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return groupByFolder(notes).map(([folder]) => ({ params: { folder }, props: { folder } }));
}

const { folder } = Astro.props;
const notes = await getCollection('notes', ({ data }) => !data.draft);
const entries = sortNotes(notes.filter((note) => folderOf(note) === folder));
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={folder} description={`${folder}目录下的笔记。`}>
  <main class="site-main" id="main">
    <a class="back-link" href={`${root}folders/`}>← 文件夹</a>
    <div class="page-intro">
      <h1>{folder}</h1>
      <p class="page-count">{entries.length} 篇</p>
    </div>
    <NoteList notes={entries} />
  </main>
</BaseLayout>
