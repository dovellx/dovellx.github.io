---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import NoteList from '../../components/NoteList.astro';
import { collectTags, sortNotes } from '../../lib/notes.mjs';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return collectTags(notes).map(([tag]) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const notes = await getCollection('notes', ({ data }) => !data.draft);
const entries = sortNotes(notes.filter((note) => note.data.tags.includes(tag)));
const root = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`#${tag}`} description={`带有${tag}标签的笔记。`}>
  <div class="content-grid">
    <Sidebar notes={notes} activeTag={tag} />
    <main class="main-content">
      <div class="page-intro compact">
        <a class="breadcrumb" href={root}>← 全部笔记</a>
        <div class="eyebrow"><span class="eyebrow-line"></span> 标签 / TAG</div>
        <h1>#{tag}</h1>
        <p>共 {entries.length} 篇笔记</p>
      </div>
      <div class="single-list"><NoteList notes={entries} /></div>
    </main>
  </div>
</BaseLayout>
